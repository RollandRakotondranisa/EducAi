namespace P7_Module_IA {
  class RAGService {
    -embeddings: GoogleGenerativeAIEmbeddings
    -vectorStores: dict
    -lock: RLock
    -indexDir: Path
    +split_text(text: str, document_id: int, course_id: int, teacher_id: int): List~LangChainDocument~
    +create_index(text: str, document_id: int, course_id: int, teacher_id: int): dict
    +search(query: str, course_id: int, document_id: Optional~int~, teacher_id: int, k: int): List~LangChainDocument~
    +get_context(query: str, course_id: int, document_id: Optional~int~, teacher_id: int, k: int): str
    +get_full_context(course_id: int, teacher_id: int, document_id: Optional~int~): str
    -_load_indexes(): None
  }
  class QuestionService {
    -llm: ChatGoogleGenerativeAI
    +generate_questions(context: str, number_of_questions: int, question_type: str, difficulty: str): dict
    +generate_from_document(query: str, teacher_id: int, course_id: int, document_id: int, number_of_questions: int, question_type: str, difficulty: str): dict
  }
  class CorrectionService {
    -llm: ChatGoogleGenerativeAI
    +correct_answer(question: str, expected_answer: str, student_answer: str, points: int): dict
  }
  class LLMRequest {
    +message: str
    +role: Literal~TEACHER,STUDENT,ADMIN~
    +context: dict~str,Any~
  }
  class DocumentAnalysisResponse {
    +filename: str
    +file_type: str
    +characters: int
    +words: int
    +text: str
  }
  class DocumentIndexRequest {
    +document_id: int
    +course_id: int
    +teacher_id: int
    +text: str
  }
  class DocumentIndexResponse {
    +document_id: int
    +course_id: int
    +chunks: int
    +status: str
  }
  class RAGSearchRequest {
    +query: str
    +course_id: int
    +document_id: int
    +teacher_id: int
    +k: int
  }
  class DocumentChatRequest {
    +message: str
    +document_id: int?
    +course_id: int
    +teacher_id: int
  }
  class CourseChatRequest {
    +message: str
    +course_id: int
    +teacher_id: int
  }
  class RAGSearchResult {
    +content: str
    +document_id: int
    +course_id: int
  }
  class RAGSearchResponse {
    +results: List~RAGSearchResult~
    +query: str
    +course_id: int
  }
  class QuestionOption {
    +id: str
    +text: str
  }
  class Question {
    +id: str
    +type: Literal~mcq,open~
    +question: str
    +options: List~QuestionOption~
    +correct_answer: str?
    +explanation: str?
    +difficulty: Literal~easy,medium,hard~
    +points: int
    +validate_mcq(): Question
  }
  class QuestionGenerationRequest {
    +query: str
    +teacher_id: int
    +document_id: int
    +course_id: int
    +number_of_questions: int
    +question_type: Literal~mcq,open~
    +difficulty: Literal~easy,medium,hard~
  }
  class QuestionGenerationResponse {
    +questions: List~Question~
    +source: str?
  }
  class CorrectionRequest {
    +question: str
    +expected_answer: str
    +student_answer: str
    +points: int
  }
