        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_Session_3" name="expiresAt"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_Session_4" name="revokedAt"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_21_2" name="user" type="C_User" association="AS_21" lower="1" upper="1"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AcademicYear" name="Academic year">
