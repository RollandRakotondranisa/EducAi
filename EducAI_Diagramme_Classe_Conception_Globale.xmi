<?xml version="1.0" encoding="utf-8"?>
<xmi:XMI xmlns:uml="http://www.omg.org/spec/UML/20131001" xmlns:xmi="http://www.omg.org/XMI" xmi:version="2.1">
  <uml:Model xmi:id="EduAI_Design_Model" name="EducAI Global Design Class Model">
    <packagedElement xmi:type="uml:Package" xmi:id="P_Presentation" name="Presentation Layer">
      <packagedElement xmi:type="uml:Class" xmi:id="C_WebApp" name="React application">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_WebApp_1" name="start"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_WebApp_2" name="renderRoutes"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AuthPages" name="Authentication pages">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AuthPages_1" name="login"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AuthPages_2" name="register"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AdminDashboard" name="Administration dashboard">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AdminDashboard_1" name="loadOverview"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AdminDashboard_2" name="manageUsers"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_TeacherDashboard" name="Teacher dashboard">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_TeacherDashboard_1" name="loadCourses"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_TeacherDashboard_2" name="manageExams"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_StudentDashboard" name="Student dashboard">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_StudentDashboard_1" name="loadCourses"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_StudentDashboard_2" name="viewResults"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_MessagesPage" name="Messaging interface">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_MessagesPage_1" name="loadInbox"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_MessagesPage_2" name="sendMessage"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_ApiClient" name="Frontend API client">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ApiClient_1" name="get"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ApiClient_2" name="post"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ApiClient_3" name="put"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ApiClient_4" name="delete"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="P_API" name="Backend API and business services">
      <packagedElement xmi:type="uml:Class" xmi:id="C_ExpressApp" name="Express API application">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExpressApp_1" name="registerRoutes"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExpressApp_2" name="handleErrors"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AuthController" name="Authentication controller">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AuthController_1" name="register"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AuthController_2" name="login"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AuthController_3" name="refresh"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AuthController_4" name="logout"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AuthService" name="Authentication service">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AuthService_1" name="createUser"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AuthService_2" name="authenticate"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AuthService_3" name="createSession"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AcademicController" name="Academic controller">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AcademicController_1" name="listStructure"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AcademicController_2" name="manageClasses"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AcademicService" name="Academic service">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AcademicService_1" name="getStructure"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AcademicService_2" name="manageAcademicData"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_CourseController" name="Course controller">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_CourseController_1" name="createCourse"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_CourseController_2" name="getCourses"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_CourseController_3" name="updateCourse"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_CourseService" name="Course service">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_CourseService_1" name="createCourse"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_CourseService_2" name="getCourse"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_CourseService_3" name="enrollStudent"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_DocumentController" name="Document controller">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_DocumentController_1" name="upload"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_DocumentController_2" name="preview"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_DocumentController_3" name="download"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_DocumentController_4" name="remove"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_DocumentService" name="Document service">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_DocumentService_1" name="storeDocument"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_DocumentService_2" name="recordHistory"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_DocumentService_3" name="indexDocument"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_ExamController" name="Exam controller">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExamController_1" name="createExam"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExamController_2" name="publishExam"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExamController_3" name="getResults"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_ExamService" name="Exam service">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExamService_1" name="createExam"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExamService_2" name="publishExam"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExamService_3" name="calculateResults"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_ExamAttemptService" name="Exam attempt service">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExamAttemptService_1" name="startAttempt"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExamAttemptService_2" name="saveAnswer"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExamAttemptService_3" name="submitAttempt"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_ExamGradingAIService" name="AI grading client">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_ExamGradingAIService_1" name="suggestGrades"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AIController" name="AI controller">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AIController_1" name="chat"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AIController_2" name="documentChat"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AIController_3" name="courseChat"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_StudentAIService" name="Student AI service">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_StudentAIService_1" name="askAssistant"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_StudentAIService_2" name="askAboutCourse"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AIServiceClient" name="AI service HTTP client">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AIServiceClient_1" name="analyzeDocument"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AIServiceClient_2" name="askLLM"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AIServiceClient_3" name="requestGrading"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_MessageController" name="Message controller">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_MessageController_1" name="getInbox"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_MessageController_2" name="sendMessage"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_MessageController_3" name="markAsRead"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_MessageService" name="Message service">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_MessageService_1" name="send"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_MessageService_2" name="getInbox"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_MessageService_3" name="downloadAttachment"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AnnouncementController" name="Announcement controller">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AnnouncementController_1" name="list"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AnnouncementController_2" name="create"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AnnouncementController_3" name="delete"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AnnouncementService" name="Announcement service">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AnnouncementService_1" name="publish"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AnnouncementService_2" name="listForUser"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AuthMiddleware" name="Authentication middleware">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_AuthMiddleware_1" name="authenticate"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_TenantContext" name="Organization access context">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_TenantContext_1" name="applyTenantScope"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_Database" name="MySQL database via Sequelize">
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Database_1" name="connect"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="OP_Database_2" name="runMigrations"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="P_DOMAIN" name="Domain and persistence model">
      <packagedElement xmi:type="uml:Class" xmi:id="C_User" name="User">
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_User_1" name="id"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_User_2" name="firstName"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_User_3" name="lastName"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_User_4" name="email"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_User_5" name="role"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_User_6" name="isActive"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_User_7" name="isSuperAdmin"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_01_2" name="organization" type="C_Organization" association="AS_01" lower="0" upper="1"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_04_1" name="teachingCourses" type="C_Course" association="AS_04" lower="0" upper="*"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_06_1" name="enrollments" type="C_CourseStudent" association="AS_06" lower="0" upper="*"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_08_1" name="uploadedDocuments" type="C_Document" association="AS_08" lower="0" upper="*"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_12_1" name="attempts" type="C_ExamAttempt" association="AS_12" lower="0" upper="*"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_16_1" name="results" type="C_ExamResult" association="AS_16" lower="0" upper="*"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_17_1" name="sentMessages" type="C_Message" association="AS_17" lower="0" upper="*"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_18_1" name="receivedMessages" type="C_Message" association="AS_18" lower="0" upper="*"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_21_1" name="sessions" type="C_Session" association="AS_21" lower="0" upper="*"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_Organization" name="Organization">
