        <ownedAttribute xmi:type="uml:Property" xmi:id="END_24_1" name="classes" type="C_AcademicClass" association="AS_24" lower="0" upper="*"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_AcademicClass" name="Academic class">
