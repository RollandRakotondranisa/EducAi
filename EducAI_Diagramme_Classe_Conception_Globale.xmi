        <ownedAttribute xmi:type="uml:Property" xmi:id="END_04_2" name="teacher" type="C_User" association="AS_04" lower="1" upper="1"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_05_1" name="enrollments" type="C_CourseStudent" association="AS_05" lower="0" upper="*"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_07_1" name="documents" type="C_Document" association="AS_07" lower="0" upper="*"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="END_09_1" name="exams" type="C_Exam" association="AS_09" lower="0" upper="*"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_CourseStudent" name="Course enrollment">
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_CourseStudent_1" name="id"/>
