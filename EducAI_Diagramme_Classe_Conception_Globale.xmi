        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_AcademicClass_3" name="academicYearId"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="ATTR_AcademicClass_4" name="programId"/>
