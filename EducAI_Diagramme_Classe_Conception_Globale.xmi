        <ownedAttribute xmi:type="uml:Property" xmi:id="END_03_1" name="announcements" type="C_Announcement" association="AS_03" lower="0" upper="*"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="C_UserRequest" name="User request">
